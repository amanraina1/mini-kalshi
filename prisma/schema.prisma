generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id                   @default(uuid())
  username        String        @unique
  password        String        @map("password_hash")
  role            Role          @default(user)
  balance         Int           @default(0)   // cents
  lockedBalance   Int           @default(0)           @map("locked_balance") // cents
  createdAt       DateTime      @map("created_at")    @default(now())
  updatedAt       DateTime      @map("updated_at")    @updatedAt

  markets         Market[]
  stockBalances   StockBalance[]
  // eventLogs       EventLog[]
  // orders          Order[]

  @@map("user")
}

enum Role {
  user
  admin
}

model Market {
  id            String          @id                     @default(uuid())
  title         String
  creatorId     String          @map("creator_id")
  resolution    Resolution      @default(pending)
  outcome       Outcome?       
  totalIssued   Int             @map("total_issued")    @default(0)

  resolvedAt    DateTime?       @map("resolved_at")
  createdAt     DateTime        @map("created_at")      @default(now())
  updatedAt     DateTime        @map("updated_at")      @updatedAt

  creator       User            @relation(fields: [creatorId], references: [id])

  stockBalances StockBalance[]
  // eventLohs     EventLog[]
  // orders        Order[]

  @@map("market")
}

enum Resolution {
  pending
  resolved
}

enum Outcome {
  yes
  no
}

model StockBalance {
  id            String        @id                     @default(uuid())
  marketId      String        @map("market_id")
  userId        String        @map("user_id")
  yesQty        Int           @map("yes_qty")         @default(0)
  noQty         Int           @map("no_qty")          @default(0)
  lockedYesQty  Int           @map("locked_yes_qty")  @default(0)
  lockedNoQty   Int           @map("locked_no_qty")   @default(0)
  updatedAt     DateTime      @map("updated_at")      @updatedAt

  user        User          @relation(fields: [userId], references: [id])
  market      Market        @relation(fields: [marketId], references: [id])

  @@unique([marketId, userId])
  @@index([userId])
  @@map("stock_balance")
}

